        "itemId": "turn-item:provider:codex:native-item:msg_0a00c010b74921cf016adb28134c8c819199106e9e4acb6ade",
        "runId": "run:thread:53d0b426-056c-4920-a3df-13786d026007:ordinal:230",
        "messageId": "message:provider:codex:native-item:msg_0a00c010b74921cf016adb28134c8c819199106e9e4acb6ade",
